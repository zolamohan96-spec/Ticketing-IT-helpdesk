<header class="main-header">
  <nav class="navbar navbar-static-top">
    <div class="container">
      <div class="navbar-header">
        <a href="/" class="navbar-brand"><i class="fa fa-life-ring"></i> <b>Helpdesk Central</b></a>
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-nav"><i class="fa fa-bars"></i></button>
      </div>
      <div class="collapse navbar-collapse" id="main-nav">
        <ul class="nav navbar-nav">
          <li class="<%= currentPath === '/' ? 'active' : '' %>"><a href="/"><i class="fa fa-dashboard"></i> Dashboard</a></li>
          <li class="<%= currentPath === '/tickets' ? 'active' : '' %>"><a href="/tickets"><i class="fa fa-ticket"></i> Semua Tiket</a></li>
          <li class="<%= currentPath.indexOf('/tickets/history') === 0 ? 'active' : '' %>"><a href="/tickets/history"><i class="fa fa-archive"></i> Riwayat</a></li>
          <% if (currentUser && currentUser.role === 'admin') { %>
          <li class="<%= currentPath.indexOf('/users') === 0 ? 'active' : '' %>"><a href="/users"><i class="fa fa-users"></i> Kelola Pengguna</a></li>
          <% } %>
          <li class="<%= currentPath === '/profile' ? 'active' : '' %>"><a href="/profile"><i class="fa fa-user"></i> Profil Saya</a></li>
        </ul>
        <a href="/tickets/new" class="btn btn-primary navbar-btn navbar-right"><i class="fa fa-plus"></i> Buat Tiket</a>
        <% if (currentUser) { %>
        <form method="post" action="/auth/logout" class="navbar-form navbar-right user-nav-form">
          <a href="/profile" class="navbar-text user-info-badge" title="Klik untuk mengedit profil dan ganti password" style="text-decoration: none; cursor: pointer;">
            <i class="fa fa-user-circle"></i> <%= currentUser.name || currentUser.username %>
            <span class="badge <%= currentUser.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= currentUser.role === 'admin' ? 'Admin' : 'User' %></span>
          </a>
          <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-sign-out"></i> Keluar</button>
        </form>
        <% } %>
      </div>
    </div>
  </nav>
</header>
