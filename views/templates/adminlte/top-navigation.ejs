<header class="main-header">
  <!-- Logo -->
  <a href="/" class="logo">
    <!-- mini logo for sidebar mini 50x50 pixels -->
    <span class="logo-mini"><i class="fa fa-life-ring text-info"></i></span>
    <!-- logo for regular state and mobile devices -->
    <span class="logo-lg"><i class="fa fa-life-ring text-info" style="margin-right: 6px;"></i> <b>Helpdesk</b> Central</span>
  </a>

  <!-- Header Navbar -->
  <nav class="navbar navbar-static-top" role="navigation">
    <!-- Sidebar toggle button-->
    <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button" title="Buka / Tutup Sidebar">
      <span class="sr-only">Toggle navigation</span>
    </a>

    <!-- Navbar Right Menu -->
    <div class="navbar-custom-menu">
      <ul class="nav navbar-nav">
        <!-- Quick Create Ticket Button in Top Bar -->
        <li>
          <a href="/tickets/new" class="top-btn-new-ticket" title="Buat Laporan Tiket Baru">
            <i class="fa fa-plus"></i> <span class="hidden-xs">Buat Tiket</span>
          </a>
        </li>

        <% if (currentUser) { %>
        <!-- User Account in Top Bar -->
        <li class="dropdown user user-menu">
          <a href="/profile" title="Buka Profil Saya">
            <% if (currentUser.avatar) { %>
              <img src="<%= currentUser.avatar %>" class="user-image" alt="Avatar" style="width: 26px; height: 26px; border-radius: 50%; object-fit: cover; vertical-align: middle; margin-right: 6px; border: 1.5px solid rgba(255,255,255,0.6);">
            <% } else { %>
              <i class="fa fa-user-circle" style="font-size: 18px; vertical-align: middle; margin-right: 5px;"></i>
            <% } %>
            <span class="hidden-xs" style="font-weight: 600;"><%= currentUser.name || currentUser.username %></span>
            <span class="badge <%= currentUser.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="margin-left: 6px; font-size: 11px;">
              <%= currentUser.role === 'admin' ? 'Admin' : 'User' %>
            </span>
          </a>
        </li>

        <!-- Logout Action Button -->
        <li>
          <form method="post" action="/auth/logout" style="margin: 0; padding: 0; display: inline-block;">
            <button type="submit" class="btn-top-logout-link" title="Keluar dari Akun">
              <i class="fa fa-sign-out"></i> <span class="hidden-xs">Keluar</span>
            </button>
          </form>
        </li>
        <% } %>
      </ul>
    </div>
  </nav>
</header>

<!-- Left side column. contains the logo and sidebar -->
<aside class="main-sidebar">
  <section class="sidebar">
    <!-- Sidebar User Panel -->
    <% if (currentUser) { %>
    <div class="user-panel">
      <div class="pull-left image">
        <a href="/profile" title="Klik untuk mengedit profil & foto">
          <% if (currentUser.avatar) { %>
            <img src="<%= currentUser.avatar %>" class="img-circle" alt="User Image" style="width: 46px; height: 46px; object-fit: cover; border: 2.5px solid #0284c7;">
          <% } else { %>
            <div style="width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #0b1329); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; border: 2.5px solid #0284c7;">
              <i class="fa <%= currentUser.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
            </div>
          <% } %>
        </a>
      </div>
      <div class="pull-left info">
        <p style="font-weight: 700; font-size: 14px; margin: 0 0 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px;">
          <a href="/profile" style="color: #ffffff;"><%= currentUser.name || currentUser.username %></a>
        </p>
        <span class="badge <%= currentUser.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="font-size: 10.5px; padding: 2px 8px;">
          <i class="fa <%= currentUser.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
          <%= currentUser.role === 'admin' ? 'Administrator' : 'User Standar' %>
        </span>
      </div>
    </div>
    <% } %>

    <!-- Sidebar Menu -->
    <ul class="sidebar-menu" data-widget="tree">
      <li class="header">NAVIGASI UTAMA</li>
      
      <li class="<%= currentPath === '/' ? 'active' : '' %>">
        <a href="/">
          <i class="fa fa-dashboard"></i> <span>Dashboard</span>
        </a>
      </li>

      <li class="<%= currentPath === '/tickets' ? 'active' : '' %>">
        <a href="/tickets">
          <i class="fa fa-ticket"></i> <span>Semua Tiket</span>
        </a>
      </li>

      <li class="<%= currentPath.indexOf('/tickets/history') === 0 ? 'active' : '' %>">
        <a href="/tickets/history">
          <i class="fa fa-archive"></i> <span>Riwayat Tiket</span>
        </a>
      </li>

      <% if (currentUser && currentUser.role === 'admin') { %>
      <li class="header">ADMINISTRASI</li>
      <li class="<%= currentPath.indexOf('/users') === 0 ? 'active' : '' %>">
        <a href="/users">
          <i class="fa fa-users"></i> <span>Kelola Pengguna</span>
        </a>
      </li>
      <% } %>

      <li class="header">PENGATURAN &amp; AKUN</li>
      <li class="<%= currentPath === '/profile' ? 'active' : '' %>">
        <a href="/profile">
          <i class="fa fa-user"></i> <span>Profil Saya</span>
        </a>
      </li>

      <li class="header">AKSI &amp; APLIKASI</li>
      <li class="<%= currentPath === '/tickets/new' ? 'active' : '' %>">
        <a href="/tickets/new" class="sidebar-action-highlight">
          <i class="fa fa-plus-circle"></i> <span>Buat Tiket Baru</span>
        </a>
      </li>

      <li>
        <a href="/download/apk" class="sidebar-apk-highlight">
          <i class="fa fa-android"></i> <span>Unduh APK Android</span>
        </a>
      </li>
    </ul>

    <!-- Logout button in sidebar -->
    <% if (currentUser) { %>
    <div class="sidebar-footer-action">
      <form method="post" action="/auth/logout">
        <button type="submit" class="btn btn-block btn-sidebar-logout">
          <i class="fa fa-sign-out"></i> Keluar (Logout)
        </button>
      </form>
    </div>
    <% } %>
  </section>
</aside>
