<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Masuk | Helpdesk Central</title>
  <link rel="stylesheet" href="/script-adminlte/bower_components/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/script-adminlte/bower_components/font-awesome/css/font-awesome.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/ticketing.css">
</head>
<body class="premium-login-body">
  <!-- Background Glow & Grid -->
  <div class="login-bg-mesh">
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>
    <div class="bg-grid-overlay"></div>
  </div>

  <div class="login-wrapper">
    <div class="login-split-card">
      <!-- Left Hero Banner -->
      <div class="login-hero-side">
        <div class="hero-brand">
          <div class="hero-logo-box">
            <i class="fa fa-life-ring"></i>
          </div>
          <div class="hero-brand-text">
            <h2>Helpdesk <span>Central</span></h2>
            <p>IT Service &amp; Ticket Management</p>
          </div>
        </div>

        <div class="hero-tagline">
          <span class="live-pill"><span class="live-dot"></span> Sistem Antrean Online</span>
          <h3>Solusi terpadu pemantauan kendala &amp; layanan IT perusahaan.</h3>
        </div>

        <div class="hero-features">
          <div class="feature-item">
            <div class="feature-icon"><i class="fa fa-clock-o"></i></div>
            <div class="feature-info">
              <strong>Urutan Antrean Real-Time</strong>
              <span>Setiap tiket mendapatkan nomor antrean FIFO otomatis</span>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="fa fa-shield"></i></div>
            <div class="feature-info">
              <strong>Hak Akses Multi-Peran</strong>
              <span>Panel khusus Administrator dan Pengguna (User)</span>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="fa fa-mobile"></i></div>
            <div class="feature-info">
              <strong>Dukungan Aplikasi Android</strong>
              <span>Upload foto kendala langsung dari kamera / galeri HP</span>
            </div>
          </div>
        </div>

        <div class="hero-footer">
          <i class="fa fa-lock"></i> Terproteksi enkripsi PBKDF2 &bull; Versi 2.0
        </div>
      </div>

      <!-- Right Form Section -->
      <div class="login-form-side">
        <div class="form-header">
          <h3>Selamat Datang</h3>
          <p>Silakan masuk untuk mengakses portal tiket &amp; antrean</p>
        </div>

        <!-- Alert Error -->
        <% if (error) { %>
          <div class="form-alert form-alert-danger">
            <i class="fa fa-exclamation-circle"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <form method="post" action="/auth/login" id="loginForm" class="auth-form" onsubmit="saveLastUser()">
          <input type="hidden" name="next" value="<%= next || '/' %>">

          <div class="auth-field-group">
            <label for="usernameInput" class="auth-label">Username</label>
            <div class="auth-input-box">
              <i class="fa fa-user-circle auth-icon"></i>
              <input type="text" id="usernameInput" name="username" class="auth-input" placeholder="Masukkan username Anda" required autofocus autocomplete="username">
            </div>
          </div>

          <div class="auth-field-group">
            <div class="auth-label-row">
              <label for="passwordInput" class="auth-label">Password</label>
              <button type="button" class="btn-toggle-pwd" onclick="togglePasswordVisibility()" title="Tampilkan / Sembunyikan Password">
                <i class="fa fa-eye" id="togglePasswordIcon"></i> <span id="togglePasswordText">Lihat</span>
              </button>
            </div>
            <div class="auth-input-box">
              <i class="fa fa-lock auth-icon"></i>
              <input type="password" id="passwordInput" name="password" class="auth-input" placeholder="Masukkan password Anda" required autocomplete="current-password">
            </div>
          </div>

          <button type="submit" class="btn-login-submit" id="submitBtn">
            <span>Masuk ke Akun</span>
            <i class="fa fa-arrow-right"></i>
          </button>
        </form>

        <!-- Divider -->
        <div class="auth-divider">
          <span>AKSES CEPAT PENGGUNA TERAKHIR</span>
        </div>

        <!-- Single Last Used User Card -->
        <div class="last-user-card-wrapper">
          <div class="demo-card demo-card-single" id="singleLastCard" onclick="applyLastUser()">
            <div class="demo-card-top">
              <span class="role-tag" id="lastRoleTag"><i class="fa fa-user" id="lastRoleIcon"></i> <span id="lastRoleLabel">User</span></span>
              <span class="use-pill"><i class="fa fa-bolt"></i> Masuk Cepat</span>
            </div>
            <div class="demo-card-body">
              <div class="cred-row">
                <span>Pengguna Terakhir:</span>
                <strong id="lastUsernameDisplay" style="color: #0f172a; font-size: 13px;">user</strong>
              </div>
              <div class="cred-row">
                <span>Kata Sandi:</span>
                <code class="pass-masked">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</code>
              </div>
            </div>
            <div class="demo-card-bottom" id="lastDescDisplay">
              Klik untuk mengisi data akun terakhir ini
            </div>
          </div>
          
          <div class="switch-user-row">
            <button type="button" class="btn-switch-account" onclick="switchDefaultUser()" id="btnSwitchAccount">
              <i class="fa fa-refresh"></i> Ganti ke akun <span id="switchTargetName">Admin</span>
            </button>
          </div>
        </div>

        <!-- Download APK Section -->
        <a href="/download/apk" class="apk-download-action">
          <div class="apk-icon-circle"><i class="fa fa-android"></i></div>
          <div class="apk-text-group">
            <strong>Unduh Aplikasi Android (.APK)</strong>
            <span>Instal di HP untuk akses praktis &amp; cepat</span>
          </div>
          <span class="apk-badge">v2.0 APK</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    const STORAGE_KEY_LAST_USER = 'helpdesk_last_username';
    const STORAGE_KEY_LAST_ROLE = 'helpdesk_last_role';

    // Predefined credentials mapping
    const KNOWN_CREDS = {
      'admin': { pass: 'Admin@12345', role: 'admin', roleLabel: 'Admin', icon: 'fa-shield', desc: 'Hak akses Administrator penuh' },
      'user': { pass: 'User@12345', role: 'user', roleLabel: 'User', icon: 'fa-user', desc: 'Hak akses Pengguna Helpdesk' }
    };

    function updateSingleCard(username) {
      const u = (username || 'user').toLowerCase();
      const card = document.getElementById('singleLastCard');
      const roleTag = document.getElementById('lastRoleTag');
      const roleIcon = document.getElementById('lastRoleIcon');
      const roleLabel = document.getElementById('lastRoleLabel');
      const userDisplay = document.getElementById('lastUsernameDisplay');
      const descDisplay = document.getElementById('lastDescDisplay');
      const switchTarget = document.getElementById('switchTargetName');

      userDisplay.textContent = username;

      if (u === 'admin') {
        card.className = 'demo-card demo-card-single demo-card-admin';
        roleTag.className = 'role-tag role-tag-admin';
        roleIcon.className = 'fa fa-shield';
        roleLabel.textContent = 'Admin';
        descDisplay.textContent = 'Hak akses Administrator (Kelola tiket & user)';
        if (switchTarget) switchTarget.textContent = 'User';
      } else {
        card.className = 'demo-card demo-card-single demo-card-user';
        roleTag.className = 'role-tag role-tag-user';
        roleIcon.className = 'fa fa-user';
        roleLabel.textContent = 'User';
        descDisplay.textContent = 'Hak akses Pengguna (Laporan & antrean tiket)';
        if (switchTarget) switchTarget.textContent = 'Admin';
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      let lastUsername = localStorage.getItem(STORAGE_KEY_LAST_USER);
      if (!lastUsername) {
        lastUsername = 'user'; // default initial last user
      }

      updateSingleCard(lastUsername);

      const uInput = document.getElementById('usernameInput');
      if (uInput && !uInput.value) {
        uInput.value = lastUsername;
        const pInput = document.getElementById('passwordInput');
        if (pInput) pInput.focus();
      }
    });

    function saveLastUser() {
      const uInput = document.getElementById('usernameInput');
      if (uInput && uInput.value.trim()) {
        const val = uInput.value.trim();
        localStorage.setItem(STORAGE_KEY_LAST_USER, val);
      }
    }

    function applyLastUser() {
      let lastUsername = localStorage.getItem(STORAGE_KEY_LAST_USER) || 'user';
      const uInput = document.getElementById('usernameInput');
      const pInput = document.getElementById('passwordInput');
      
      uInput.value = lastUsername;
      
      const key = lastUsername.toLowerCase();
      if (KNOWN_CREDS[key]) {
        pInput.value = KNOWN_CREDS[key].pass;
      } else {
        pInput.value = '';
        pInput.focus();
      }

      const card = document.getElementById('singleLastCard');
      if (card) card.classList.add('active-demo-card');

      uInput.classList.add('highlight-pulse');
      pInput.classList.add('highlight-pulse');
      setTimeout(() => {
        uInput.classList.remove('highlight-pulse');
        pInput.classList.remove('highlight-pulse');
      }, 400);

      document.getElementById('submitBtn').focus();
    }

    function switchDefaultUser() {
      let current = localStorage.getItem(STORAGE_KEY_LAST_USER) || 'user';
      let nextUser = (current.toLowerCase() === 'admin') ? 'user' : 'admin';
      
      localStorage.setItem(STORAGE_KEY_LAST_USER, nextUser);
      updateSingleCard(nextUser);
      applyLastUser();
    }

    function togglePasswordVisibility() {
      const pInput = document.getElementById('passwordInput');
      const icon = document.getElementById('togglePasswordIcon');
      const text = document.getElementById('togglePasswordText');

      if (pInput.type === 'password') {
        pInput.type = 'text';
        icon.className = 'fa fa-eye-slash';
        text.innerText = 'Tutup';
      } else {
        pInput.type = 'password';
        icon.className = 'fa fa-eye';
        text.innerText = 'Lihat';
      }
    }
  </script>
</body>
</html>
