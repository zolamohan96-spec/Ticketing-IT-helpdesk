<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login | Helpdesk Central</title>
  <link rel="stylesheet" href="/script-adminlte/bower_components/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/script-adminlte/bower_components/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="/script-adminlte/dist/css/AdminLTE.min.css">
  <link rel="stylesheet" href="/css/ticketing.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="modern-login-body">
  <div class="login-backdrop">
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
  </div>

  <div class="modern-login-container">
    <div class="login-card">
      <!-- Brand Header -->
      <div class="card-brand-header">
        <div class="brand-badge-icon">
          <i class="fa fa-life-ring"></i>
        </div>
        <h1 class="brand-title">Helpdesk <span>Central</span></h1>
        <p class="brand-subtitle">Portal Layanan Troubleshooting & Antrean Tiket IT</p>
      </div>

      <!-- Alert Error -->
      <% if (error) { %>
        <div class="modern-alert modern-alert-danger">
          <i class="fa fa-exclamation-circle alert-icon"></i>
          <div class="alert-content"><%= error %></div>
        </div>
      <% } %>

      <!-- Login Form -->
      <form method="post" action="/auth/login" id="loginForm" class="modern-form">
        <input type="hidden" name="next" value="<%= next || '/' %>">

        <div class="form-group-modern">
          <label for="usernameInput" class="modern-label">Username</label>
          <div class="input-wrapper">
            <i class="fa fa-user-circle input-icon"></i>
            <input type="text" id="usernameInput" name="username" class="modern-input" placeholder="Masukkan username Anda" required autofocus autocomplete="username">
          </div>
        </div>

        <div class="form-group-modern">
          <div class="label-row">
            <label for="passwordInput" class="modern-label">Password</label>
            <span class="password-toggle" onclick="togglePasswordVisibility()" title="Tampilkan / Sembunyikan Password">
              <i class="fa fa-eye" id="togglePasswordIcon"></i> <span id="togglePasswordText">Lihat</span>
            </span>
          </div>
          <div class="input-wrapper">
            <i class="fa fa-lock input-icon"></i>
            <input type="password" id="passwordInput" name="password" class="modern-input" placeholder="Masukkan password Anda" required autocomplete="current-password">
          </div>
        </div>

        <button type="submit" class="btn-modern-primary" id="submitBtn">
          <span>Masuk ke Akun</span>
          <i class="fa fa-arrow-right"></i>
        </button>
      </form>

      <!-- Divider -->
      <div class="modern-divider">
        <span>KREDENSIAL DEMO</span>
      </div>

      <!-- Credential Quick Cards -->
      <div class="quick-credentials-grid">
        <!-- Admin Card -->
        <div class="quick-card quick-card-admin" onclick="applyCreds('admin', 'Admin@12345', this)">
          <div class="quick-card-header">
            <div class="quick-role-badge badge-role-admin">
              <i class="fa fa-shield"></i> Admin
            </div>
            <span class="quick-btn-tag"><i class="fa fa-check"></i> Gunakan</span>
          </div>
          <div class="quick-card-body">
            <div class="quick-user-info">
              <span class="cred-label">User:</span> <code>admin</code>
            </div>
            <div class="quick-user-info">
              <span class="cred-label">Pass:</span> <code>Admin@12345</code>
            </div>
          </div>
          <div class="quick-card-footer">
            Akses penuh & kelola user
          </div>
        </div>

        <!-- User Card -->
        <div class="quick-card quick-card-user" onclick="applyCreds('user', 'User@12345', this)">
          <div class="quick-card-header">
            <div class="quick-role-badge badge-role-user">
              <i class="fa fa-user"></i> User
            </div>
            <span class="quick-btn-tag"><i class="fa fa-check"></i> Gunakan</span>
          </div>
          <div class="quick-card-body">
            <div class="quick-user-info">
              <span class="cred-label">User:</span> <code>user</code>
            </div>
            <div class="quick-user-info">
              <span class="cred-label">Pass:</span> <code>User@12345</code>
            </div>
          </div>
          <div class="quick-card-footer">
            Buat & pantau antrean tiket
          </div>
        </div>
      </div>

      <!-- Card Footer -->
      <div class="login-card-footer">
        <a href="/download/apk" class="apk-download-btn" title="Unduh file instalasi APK untuk HP Android">
          <i class="fa fa-android"></i> Unduh Aplikasi Android (.APK)
        </a>
        <div class="security-note">
          <i class="fa fa-lock"></i> Terenkripsi aman dengan salted PBKDF2 &bull; Helpdesk v2.0
        </div>
      </div>
    </div>
  </div>

  <script>
    function applyCreds(username, password, cardElem) {
      const uInput = document.getElementById('usernameInput');
      const pInput = document.getElementById('passwordInput');
      
      uInput.value = username;
      pInput.value = password;
      
      // Visual feedback
      document.querySelectorAll('.quick-card').forEach(c => c.classList.remove('selected-card'));
      if (cardElem) cardElem.classList.add('selected-card');
      
      uInput.classList.add('input-highlight');
      pInput.classList.add('input-highlight');
      setTimeout(() => {
        uInput.classList.remove('input-highlight');
        pInput.classList.remove('input-highlight');
      }, 500);

      document.getElementById('submitBtn').focus();
    }

    function togglePasswordVisibility() {
      const pInput = document.getElementById('passwordInput');
      const icon = document.getElementById('togglePasswordIcon');
      const text = document.getElementById('togglePasswordText');

      if (pInput.type === 'password') {
        pInput.type = 'text';
        icon.className = 'fa fa-eye-slash';
        text.innerText = 'Tutup';
      } else {
        pInput.type = 'password';
        icon.className = 'fa fa-eye';
        text.innerText = 'Lihat';
      }
    }
  </script>
</body>
</html>
