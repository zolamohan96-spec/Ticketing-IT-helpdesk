<%- include ../templates/adminlte/header-top-nav.ejs %>
<div class="content-wrapper">
  <div class="container">
    <section class="content-header">
      <h1>Profil Saya <small>Kelola data profil, foto, dan keamanan akun Anda</small></h1>
    </section>

    <section class="content">
      <% if (flashMessage) { %>
        <div class="alert alert-<%= flashMessage.type %> alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="fa <%= flashMessage.type === 'success' ? 'fa-check-circle' : 'fa-info-circle' %>"></i> <%= flashMessage.text %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="fa fa-exclamation-circle"></i> <%= error %>
        </div>
      <% } %>

      <form method="post" action="/profile" id="profileForm" enctype="multipart/form-data">
        <!-- Hidden file input triggered by clicking the avatar circle on the right card -->
        <input type="file" id="avatarFileInput" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" style="display: none;" onchange="handleAvatarSelected(this)">
        <input type="hidden" id="removeAvatarInput" name="removeAvatar" value="false">

        <div class="row">
          <!-- Edit Profile Form (Left Column) -->
          <div class="col-md-8">
            <div class="panel panel-default">
              <div class="panel-heading">
                <span class="panel-title"><i class="fa fa-user-circle"></i> Formulir Pembaruan Profil</span>
              </div>
              <div class="panel-body">
                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="username">Username</label>
                    <input id="username" class="form-control" value="<%= user.username %>" disabled readonly style="background-color: #f8fafc; font-weight: bold; color: #0f172a;">
                    <p class="help-block">Username sistem Anda bersifat permanen.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="name">Nama Lengkap <span class="text-danger">*</span></label>
                    <input id="name" name="name" class="form-control" value="<%= values.name || user.name || '' %>" required placeholder="Masukkan nama lengkap Anda" autofocus>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="email">Alamat Email</label>
                    <input id="email" name="email" type="email" class="form-control" value="<%= values.email || user.email || '' %>" placeholder="nama@email.com">
                    <p class="help-block">Alamat email untuk kontak akun.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="role">Hak Akses (Role)</label>
                    <div style="padding-top: 6px;">
                      <span class="badge <%= user.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="font-size: 13px; padding: 6px 12px;">
                        <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                        <%= user.role === 'admin' ? 'Administrator' : 'User (Pengguna Standar)' %>
                      </span>
                    </div>
                  </div>
                </div>

                <hr style="margin: 20px 0 15px;">

                <!-- Change Password Section -->
                <div class="note-box-info">
                  <h5><i class="fa fa-key"></i> Ganti Password Akun (Opsional)</h5>
                  <p>Biarkan kolom-kolom password di bawah ini <strong>kosong</strong> jika Anda tidak ingin mengganti kata sandi.</p>
                </div>

                <div class="row">
                  <div class="col-md-12 form-group">
                    <label for="oldPassword">Password Saat Ini (Lama)</label>
                    <input id="oldPassword" name="oldPassword" type="password" class="form-control" placeholder="Wajib diisi jika ingin mengganti password">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="newPassword">Password Baru</label>
                    <input id="newPassword" name="newPassword" type="password" class="form-control" placeholder="Minimal 6 karakter">
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="confirmPassword">Konfirmasi Password Baru</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" placeholder="Ketik ulang password baru">
                  </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                  <a href="/" class="btn btn-default"><i class="fa fa-arrow-left"></i> Kembali ke Dashboard</a>
                  <button type="submit" class="btn btn-primary" id="saveProfileBtn"><i class="fa fa-save"></i> Simpan Perubahan Profil</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Summary & Interactive Avatar Card -->
          <div class="col-md-4">
            <div class="panel panel-info">
              <div class="panel-heading">
                <span class="panel-title"><i class="fa fa-id-card-o"></i> Ringkasan Akun</span>
              </div>
              <div class="panel-body text-center" style="padding-top: 22px;">
                
                <!-- Interactive Avatar Box -->
                <div class="avatar-edit-container">
                  <div class="avatar-circle-wrapper" onclick="triggerAvatarUpload()" title="Klik untuk mengunggah / mengubah foto profil">
                    <% if (user.avatar) { %>
                      <img id="summaryAvatarImg" src="<%= user.avatar %>" alt="<%= user.name %>" class="summary-avatar-img">
                      <div id="summaryAvatarFallback" class="summary-avatar-fallback" style="display: none;">
                        <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                      </div>
                    <% } else { %>
                      <div id="summaryAvatarFallback" class="summary-avatar-fallback">
                        <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                      </div>
                      <img id="summaryAvatarImg" src="" alt="<%= user.name %>" class="summary-avatar-img" style="display: none;">
                    <% } %>
                    
                    <div class="avatar-camera-badge" title="Ubah Foto">
                      <i class="fa fa-camera"></i>
                    </div>
                    <div class="avatar-hover-overlay">
                      <i class="fa fa-camera"></i>
                      <span>Ubah Foto</span>
                    </div>
                  </div>

                  <span class="avatar-click-hint" onclick="triggerAvatarUpload()">
                    <i class="fa fa-camera"></i> Klik foto untuk mengubah
                  </span>

                  <!-- Status badge when new photo is selected -->
                  <div id="avatarSelectedBadge" class="avatar-chosen-badge" style="display: none;">
                    <i class="fa fa-check-circle"></i> Foto baru dipilih
                  </div>

                  <% if (user.avatar) { %>
                    <button type="button" class="btn-remove-avatar" id="btnRemoveAvatar" onclick="removeCurrentAvatar()">
                      <i class="fa fa-trash"></i> Hapus Foto Profil
                    </button>
                  <% } %>
                </div>

                <h3 style="margin: 0 0 4px; font-weight: bold; color: #0f172a;"><%= user.name || user.username %></h3>
                <p class="text-muted" style="margin-bottom: 10px;">@<%= user.username %></p>
                
                <div style="margin-bottom: 18px;">
                  <span class="badge <%= user.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="font-size: 12px; padding: 4px 10px;">
                    <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i> <%= user.role === 'admin' ? 'Administrator' : 'User Standar' %>
                  </span>
                </div>

                <ul class="list-group list-group-unbordered text-left" style="font-size: 13px;">
                  <li class="list-group-item">
                    <b>ID Pengguna</b> <span class="pull-right"><code><%= user.id %></code></span>
                  </li>
                  <li class="list-group-item">
                    <b>Email</b> <span class="pull-right"><%= user.email || '-' %></span>
                  </li>
                  <li class="list-group-item">
                    <b>Terdaftar Sejak</b> <span class="pull-right"><%= new Date(user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></span>
                  </li>
                </ul>

                <div class="text-muted text-left" style="font-size: 12px; margin-top: 15px; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                  <i class="fa fa-lock text-success"></i> Terproteksi enkripsi salted PBKDF2 (SHA-512).
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </section>
  </div>
</div>

<script>
  function triggerAvatarUpload() {
    document.getElementById('avatarFileInput').click();
  }

  function handleAvatarSelected(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      
      reader.onload = function(e) {
        const img = document.getElementById('summaryAvatarImg');
        const fallback = document.getElementById('summaryAvatarFallback');
        const badge = document.getElementById('avatarSelectedBadge');
        const removeBtn = document.getElementById('btnRemoveAvatar');
        const removeInput = document.getElementById('removeAvatarInput');

        if (img) {
          img.src = e.target.result;
          img.style.display = 'block';
        }
        if (fallback) {
          fallback.style.display = 'none';
        }
        if (badge) {
          badge.style.display = 'inline-flex';
          badge.innerHTML = '<i class="fa fa-check-circle"></i> ' + (file.name.length > 18 ? file.name.substring(0, 15) + '...' : file.name);
        }
        if (removeInput) {
          removeInput.value = 'false';
        }
        if (removeBtn) {
          removeBtn.style.display = 'none';
        }
      };
      reader.readAsDataURL(file);
    }
  }

  function removeCurrentAvatar() {
    if (confirm('Apakah Anda yakin ingin menghapus foto profil ini dan kembali ke avatar bawaan?')) {
      const img = document.getElementById('summaryAvatarImg');
      const fallback = document.getElementById('summaryAvatarFallback');
      const removeInput = document.getElementById('removeAvatarInput');
      const removeBtn = document.getElementById('btnRemoveAvatar');
      const badge = document.getElementById('avatarSelectedBadge');
      const fileInput = document.getElementById('avatarFileInput');

      if (img) img.style.display = 'none';
      if (fallback) fallback.style.display = 'flex';
      if (removeInput) removeInput.value = 'true';
      if (fileInput) fileInput.value = '';
      if (removeBtn) removeBtn.style.display = 'none';
      if (badge) {
        badge.className = 'avatar-chosen-badge';
        badge.style.background = '#fee2e2';
        badge.style.borderColor = '#fca5a5';
        badge.style.color = '#dc2626';
        badge.style.display = 'inline-flex';
        badge.innerHTML = '<i class="fa fa-info-circle"></i> Foto akan dihapus saat disimpan';
      }
    }
  }
</script>

<%- include ../templates/adminlte/footer.ejs %>
