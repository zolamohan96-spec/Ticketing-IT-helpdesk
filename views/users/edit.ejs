<%- include ../templates/adminlte/header-top-nav.ejs %>
<div class="content-wrapper">
  <div class="container">
    <section class="content-header">
      <h1>Edit Pengguna <small>Perbarui data profil, peran, dan password akun</small></h1>
    </section>

    <section class="content">
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="fa fa-exclamation-circle"></i> <%= error %>
        </div>
      <% } %>

      <form method="post" action="/users/<%= user.id %>/edit" id="editUserForm" enctype="multipart/form-data">
        <input type="file" id="editAvatarFileInput" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" style="display: none;" onchange="handleEditAvatarSelected(this)">
        <input type="hidden" id="editRemoveAvatarInput" name="removeAvatar" value="false">

        <div class="row">
          <!-- Left Form -->
          <div class="col-md-8">
            <div class="panel panel-default">
              <div class="panel-heading">
                <span class="panel-title"><i class="fa fa-pencil-square-o"></i> Formulir Edit Pengguna: <strong><%= user.username %></strong></span>
              </div>
              <div class="panel-body">
                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="username">Username (ID: <code><%= user.id %></code>)</label>
                    <input id="username" class="form-control" value="<%= user.username %>" disabled readonly style="background-color: #f1f5f9; font-weight: bold;">
                    <p class="help-block">Username sistem bersifat permanen dan tidak dapat diubah.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="name">Nama Lengkap <span class="text-danger">*</span></label>
                    <input id="name" name="name" class="form-control" value="<%= values.name || user.name || '' %>" required placeholder="Contoh: Budi Santoso" autofocus>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="email">Alamat Email</label>
                    <input id="email" name="email" type="email" class="form-control" value="<%= values.email || user.email || '' %>" placeholder="nama@perusahaan.id">
                    <p class="help-block">Opsional untuk kontak notifikasi.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="role">Peran (Role) <span class="text-danger">*</span></label>
                    <% if (user.username.toLowerCase() === 'admin') { %>
                      <input type="hidden" name="role" value="admin">
                      <select class="form-control" disabled>
                        <option value="admin" selected>Admin (Administrator Sistem - Utama)</option>
                      </select>
                      <p class="help-block text-warning"><i class="fa fa-lock"></i> Akun admin utama harus tetap memiliki peran Administrator.</p>
                    <% } else { %>
                      <select id="role" name="role" class="form-control" required>
                        <option value="user" <%= (values.role || user.role) === 'user' ? 'selected' : '' %>>User (Pengguna Standar)</option>
                        <option value="admin" <%= (values.role || user.role) === 'admin' ? 'selected' : '' %>>Admin (Administrator Sistem)</option>
                      </select>
                    <% } %>
                  </div>
                </div>

                <hr>

                <div class="note-box-info">
                  <h5><i class="fa fa-key"></i> Ubah Password (Opsional)</h5>
                  <p>Biarkan kedua kolom password di bawah ini <strong>kosong</strong> jika Anda tidak ingin mengganti password pengguna saat ini.</p>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="password">Password Baru</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Kosongkan jika tidak diubah">
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="confirmPassword">Konfirmasi Password Baru</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" placeholder="Ketik ulang password baru">
                  </div>
                </div>

                <div class="form-actions" style="margin-top: 15px;">
                  <a href="/users" class="btn btn-default"><i class="fa fa-arrow-left"></i> Batal</a>
                  <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Perbarui Pengguna</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Card with Interactive Avatar -->
          <div class="col-md-4">
            <div class="panel panel-info">
              <div class="panel-heading">
                <span class="panel-title"><i class="fa fa-info-circle"></i> Informasi Akun</span>
              </div>
              <div class="panel-body text-center" style="padding-top: 20px;">
                
                <!-- Interactive Avatar Box -->
                <div class="avatar-edit-container">
                  <div class="avatar-circle-wrapper" onclick="triggerEditAvatarUpload()" title="Klik untuk mengunggah / mengubah foto profil pengguna ini">
                    <% if (user.avatar) { %>
                      <img id="editUserAvatarImg" src="<%= user.avatar %>" alt="<%= user.name %>" class="summary-avatar-img">
                      <div id="editUserAvatarFallback" class="summary-avatar-fallback" style="display: none;">
                        <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                      </div>
                    <% } else { %>
                      <div id="editUserAvatarFallback" class="summary-avatar-fallback">
                        <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                      </div>
                      <img id="editUserAvatarImg" src="" alt="<%= user.name %>" class="summary-avatar-img" style="display: none;">
                    <% } %>
                    
                    <div class="avatar-camera-badge" title="Ubah Foto">
                      <i class="fa fa-camera"></i>
                    </div>
                    <div class="avatar-hover-overlay">
                      <i class="fa fa-camera"></i>
                      <span>Ubah Foto</span>
                    </div>
                  </div>

                  <span class="avatar-click-hint" onclick="triggerEditAvatarUpload()">
                    <i class="fa fa-camera"></i> Klik foto untuk mengubah
                  </span>

                  <!-- Status badge when new photo is selected -->
                  <div id="editAvatarSelectedBadge" class="avatar-chosen-badge" style="display: none;">
                    <i class="fa fa-check-circle"></i> Foto baru dipilih
                  </div>

                  <% if (user.avatar) { %>
                    <button type="button" class="btn-remove-avatar" id="btnEditRemoveAvatar" onclick="removeEditUserAvatar()">
                      <i class="fa fa-trash"></i> Hapus Foto
                    </button>
                  <% } %>
                </div>

                <h4 style="margin: 0 0 4px; font-weight: bold;"><%= user.name || user.username %></h4>
                <p class="text-muted" style="margin-bottom: 10px;"><code><%= user.id %></code></p>
                
                <ul class="list-group list-group-unbordered text-left" style="font-size: 13px;">
                  <li class="list-group-item">
                    <b>Tanggal Dibuat</b> <span class="pull-right"><%= new Date(user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></span>
                  </li>
                  <li class="list-group-item">
                    <b>Terakhir Diubah</b> <span class="pull-right"><%= new Date(user.updatedAt || user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></span>
                  </li>
                </ul>
                
                <div class="text-muted text-left" style="font-size: 12px; margin-top: 10px; border-top: 1px solid #e2e8f0; padding-top: 10px;">
                  <i class="fa fa-shield text-success"></i> Password tersimpan dengan enkripsi aman PBKDF2 (SHA-512).
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </section>
  </div>
</div>

<script>
  function triggerEditAvatarUpload() {
    document.getElementById('editAvatarFileInput').click();
  }

  function handleEditAvatarSelected(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      
      reader.onload = function(e) {
        const img = document.getElementById('editUserAvatarImg');
        const fallback = document.getElementById('editUserAvatarFallback');
        const badge = document.getElementById('editAvatarSelectedBadge');
        const removeBtn = document.getElementById('btnEditRemoveAvatar');
        const removeInput = document.getElementById('editRemoveAvatarInput');

        if (img) {
          img.src = e.target.result;
          img.style.display = 'block';
        }
        if (fallback) {
          fallback.style.display = 'none';
        }
        if (badge) {
          badge.style.display = 'inline-flex';
          badge.innerHTML = '<i class="fa fa-check-circle"></i> ' + (file.name.length > 18 ? file.name.substring(0, 15) + '...' : file.name);
        }
        if (removeInput) {
          removeInput.value = 'false';
        }
        if (removeBtn) {
          removeBtn.style.display = 'none';
        }
      };
      reader.readAsDataURL(file);
    }
  }

  function removeEditUserAvatar() {
    if (confirm('Apakah Anda yakin ingin menghapus foto profil pengguna ini dan kembali ke avatar bawaan?')) {
      const img = document.getElementById('editUserAvatarImg');
      const fallback = document.getElementById('editUserAvatarFallback');
      const removeInput = document.getElementById('editRemoveAvatarInput');
      const removeBtn = document.getElementById('btnEditRemoveAvatar');
      const badge = document.getElementById('editAvatarSelectedBadge');
      const fileInput = document.getElementById('editAvatarFileInput');

      if (img) img.style.display = 'none';
      if (fallback) fallback.style.display = 'flex';
      if (removeInput) removeInput.value = 'true';
      if (fileInput) fileInput.value = '';
      if (removeBtn) removeBtn.style.display = 'none';
      if (badge) {
        badge.className = 'avatar-chosen-badge';
        badge.style.background = '#fee2e2';
        badge.style.borderColor = '#fca5a5';
        badge.style.color = '#dc2626';
        badge.style.display = 'inline-flex';
        badge.innerHTML = '<i class="fa fa-info-circle"></i> Foto akan dihapus saat disimpan';
      }
    }
  }
</script>

<%- include ../templates/adminlte/footer.ejs %>
