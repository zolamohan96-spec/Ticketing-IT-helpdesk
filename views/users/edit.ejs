<%- include ../templates/adminlte/header-top-nav.ejs %>
<div class="content-wrapper">
  <div class="container">
    <section class="content-header">
      <h1>Edit Pengguna <small>Perbarui data profil, peran, dan password akun</small></h1>
    </section>

    <section class="content">
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="fa fa-exclamation-circle"></i> <%= error %>
        </div>
      <% } %>

      <div class="row">
        <div class="col-md-8">
          <div class="panel panel-default">
            <div class="panel-heading">
              <span class="panel-title"><i class="fa fa-pencil-square-o"></i> Formulir Edit Pengguna: <strong><%= user.username %></strong></span>
            </div>
            <div class="panel-body">
              <form method="post" action="/users/<%= user.id %>/edit" enctype="multipart/form-data">
                
                <!-- Avatar Section -->
                <div class="form-group" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 20px;">
                  <label style="display: block; margin-bottom: 10px; font-weight: 700; color: #0f172a;"><i class="fa fa-camera"></i> Foto Profil (Avatar)</label>
                  <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                    <div>
                      <% if (user.avatar) { %>
                        <img id="avatarPreview" src="<%= user.avatar %>" alt="Avatar" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid #0284c7;">
                      <% } else { %>
                        <div id="avatarFallback" style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #0b1329); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 26px;">
                          <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                        </div>
                        <img id="avatarPreview" src="" alt="Avatar" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid #0284c7; display: none;">
                      <% } %>
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                      <input type="file" id="avatarInput" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control" style="margin-bottom: 6px;" onchange="previewAvatar(this)">
                      <p class="help-block" style="margin-bottom: 4px; font-size: 12px;">Format: JPG, PNG, WEBP, GIF (Maksimal 5 MB).</p>
                      <% if (user.avatar) { %>
                        <label style="font-weight: normal; font-size: 12.5px; color: #dc2626; cursor: pointer;">
                          <input type="checkbox" name="removeAvatar" value="true"> Hapus foto profil pengguna ini
                        </label>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="username">Username (ID: <code><%= user.id %></code>)</label>
                    <input id="username" class="form-control" value="<%= user.username %>" disabled readonly style="background-color: #f1f5f9; font-weight: bold;">
                    <p class="help-block">Username sistem bersifat permanen dan tidak dapat diubah.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="name">Nama Lengkap <span class="text-danger">*</span></label>
                    <input id="name" name="name" class="form-control" value="<%= values.name || user.name || '' %>" required placeholder="Contoh: Budi Santoso" autofocus>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="email">Alamat Email</label>
                    <input id="email" name="email" type="email" class="form-control" value="<%= values.email || user.email || '' %>" placeholder="nama@perusahaan.id">
                    <p class="help-block">Opsional untuk kontak notifikasi.</p>
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="role">Peran (Role) <span class="text-danger">*</span></label>
                    <% if (user.username.toLowerCase() === 'admin') { %>
                      <input type="hidden" name="role" value="admin">
                      <select class="form-control" disabled>
                        <option value="admin" selected>Admin (Administrator Sistem - Utama)</option>
                      </select>
                      <p class="help-block text-warning"><i class="fa fa-lock"></i> Akun admin utama harus tetap memiliki peran Administrator.</p>
                    <% } else { %>
                      <select id="role" name="role" class="form-control" required>
                        <option value="user" <%= (values.role || user.role) === 'user' ? 'selected' : '' %>>User (Pengguna Standar)</option>
                        <option value="admin" <%= (values.role || user.role) === 'admin' ? 'selected' : '' %>>Admin (Administrator Sistem)</option>
                      </select>
                    <% } %>
                  </div>
                </div>

                <hr>

                <div class="note-box-info">
                  <h5><i class="fa fa-key"></i> Ubah Password (Opsional)</h5>
                  <p>Biarkan kedua kolom password di bawah ini <strong>kosong</strong> jika Anda tidak ingin mengganti password pengguna saat ini.</p>
                </div>

                <div class="row">
                  <div class="col-md-6 form-group">
                    <label for="password">Password Baru</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Kosongkan jika tidak diubah">
                  </div>
                  <div class="col-md-6 form-group">
                    <label for="confirmPassword">Konfirmasi Password Baru</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" placeholder="Ketik ulang password baru">
                  </div>
                </div>

                <div class="form-actions" style="margin-top: 15px;">
                  <a href="/users" class="btn btn-default"><i class="fa fa-arrow-left"></i> Batal</a>
                  <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Perbarui Pengguna</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="panel panel-info">
            <div class="panel-heading">
              <span class="panel-title"><i class="fa fa-info-circle"></i> Informasi Akun</span>
            </div>
            <div class="panel-body text-center" style="padding-top: 20px;">
              <div style="margin-bottom: 12px;">
                <% if (user.avatar) { %>
                  <img src="<%= user.avatar %>" alt="<%= user.name %>" style="width: 76px; height: 76px; border-radius: 50%; object-fit: cover; border: 2px solid #0284c7; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                <% } else { %>
                  <div style="width: 76px; height: 76px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #0b1329); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                    <i class="fa <%= user.role === 'admin' ? 'fa-shield' : 'fa-user' %>"></i>
                  </div>
                <% } %>
              </div>

              <h4 style="margin: 0 0 4px; font-weight: bold;"><%= user.name || user.username %></h4>
              <p class="text-muted" style="margin-bottom: 10px;"><code><%= user.id %></code></p>
              
              <ul class="list-group list-group-unbordered text-left" style="font-size: 13px;">
                <li class="list-group-item">
                  <b>Tanggal Dibuat</b> <span class="pull-right"><%= new Date(user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></span>
                </li>
                <li class="list-group-item">
                  <b>Terakhir Diubah</b> <span class="pull-right"><%= new Date(user.updatedAt || user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></span>
                </li>
              </ul>
              
              <div class="text-muted text-left" style="font-size: 12px; margin-top: 10px; border-top: 1px solid #e2e8f0; padding-top: 10px;">
                <i class="fa fa-shield text-success"></i> Password tersimpan dengan enkripsi aman PBKDF2 (SHA-512).
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  function previewAvatar(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('avatarPreview');
        const fallback = document.getElementById('avatarFallback');
        if (preview) {
          preview.src = e.target.result;
          preview.style.display = 'block';
        }
        if (fallback) {
          fallback.style.display = 'none';
        }
      }
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<%- include ../templates/adminlte/footer.ejs %>
